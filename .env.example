# Copy this file to .env (which is git-ignored) or export the variables
# directly in your shell before running the LLM pipeline.
#
#   cp .env.example .env
#   export GEMINI_API_KEY="..."        # bash
#   setx GEMINI_API_KEY "..."          # Windows

GEMINI_API_KEY=your-api-key-here

# Optional: override the default model
GEMINI_MODEL=gemini-2.5-flash
